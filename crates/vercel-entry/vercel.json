{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp"
    },
    {
      "source": "/authorize",
      "destination": "/api/mcp"
    },
    {
      "source": "/token",
      "destination": "/api/mcp"
    },
    {
      "source": "/oauth/consent",
      "destination": "/api/mcp"
    }
  ],
  "crons": [
    {
      "path": "/api/outbox",
      "schedule": "*/10 * * * *"
    }
  ]
}
