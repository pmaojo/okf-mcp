{
  "name": "okf-memory-mcp-app",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive brutalist UI for the 13 okf-memory MCP tools. React + Vite, compiled to a single self-contained HTML file consumed by crates/memory-tools via include_str!.",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "files": [
    "dist/mcp-app.html"
  ],
  "scripts": {
    "build": "pnpm run build:ui",
    "build:ui": "tsc --noEmit && cross-env INPUT=mcp-app.html vite build",
    "watch": "cross-env INPUT=mcp-app.html vite build --watch",
    "sync": "node scripts/sync-to-rust.mjs",
    "build:sync": "pnpm run build && pnpm run sync",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.2"
  }
}
