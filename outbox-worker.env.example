# Copia este fichero a .env (ya está en .gitignore) y rellénalo.
# Descripción completa de cada variable: README.md, sección "Outbox,
# GitHub y embeddings".

# Obligatoria.
POSTGRES_URL=postgres://usuario:password@host:5432/basededatos

# Opcionales: sin estas, outbox-worker sigue funcionando pero omite la
# sincronización con GitHub (documentos solo quedan en Supabase).
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_PATH=memoria

# Opcionales: generación de embeddings (pgvector). Sin ninguna, se
# omite esa parte y la búsqueda sigue funcionando por texto.
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# No la actives aquí: OKF_STORE=github asume que algo delante de
# outbox-worker (IndexedStore, en mcp) ya escribió en GitHub de forma
# síncrona. Si outbox-worker corre solo, déjala sin definir.
# OKF_STORE=github
